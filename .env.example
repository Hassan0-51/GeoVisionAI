# Django settings
DJANGO_SECRET_KEY=replace-with-a-strong-secret-key
DJANGO_DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database settings
DB_NAME=fyp_db
DB_USER=fyp_user
DB_PASSWORD=root
DB_HOST=localhost
DB_PORT=5433

# Cloud / AWS settings
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key

# Google Earth Engine / Google Cloud
GOOGLE_CLOUD_PROJECT=your-google-cloud-project-id
EARTHENGINE_PROJECT=your-google-cloud-project-id
GOOGLE_APPLICATION_CREDENTIALS=service-account.json

# AI access keys
OPENAI_API_KEY=your-openai-key-if-used
HF_TOKEN=your-huggingface-token

# Optional app paths
BASE_SATELLITE_IMAGE=data/satellite_image.tif
MODEL_PATH=storage/models/best_multiclass_model.pth

# Optional app configuration
FYP_DATA_ROOT=D:/FYP/Data
